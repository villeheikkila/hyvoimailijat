---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";
import mediaImageMetadata from "../data/media-image-metadata.json";

interface Props {
	image: MediaValue | string | null | undefined;
	alt?: string;
	sizes?: string;
	priority?: boolean;
	class?: string;
	width?: number;
	height?: number;
}

type ImageMetadata = {
	width: number;
	height: number;
	widths: number[];
};

const {
	image,
	alt,
	sizes = "100vw",
	priority = false,
	class: className,
	width,
	height,
} = Astro.props;

function mediaKey(value: MediaValue | string | null | undefined): string | null {
	if (!value) return null;
	if (typeof value === "string") {
		const prefix = "/_emdash/api/media/file/";
		const index = value.indexOf(prefix);
		return index === -1 ? value.split("/").pop() ?? null : value.slice(index + prefix.length);
	}

	const storageKey =
		(typeof value.meta?.storageKey === "string" ? value.meta.storageKey : undefined) ??
		value.src?.split("/_emdash/api/media/file/").at(1) ??
		value.id;

	return storageKey || null;
}

function mediaSrc(value: MediaValue | string | null | undefined, key: string | null): string | undefined {
	if (!value) return undefined;
	if (typeof value === "string") return value;
	if (value.src) return value.src;
	return key ? `/_emdash/api/media/file/${key}` : undefined;
}

function mediaWidth(value: MediaValue | string | null | undefined): number | undefined {
	if (typeof value === "object" && value?.width) return value.width;
	return undefined;
}

function mediaHeight(value: MediaValue | string | null | undefined): number | undefined {
	if (typeof value === "object" && value?.height) return value.height;
	return undefined;
}

function keyWithoutExtension(key: string): string {
	const lastSlash = key.lastIndexOf("/");
	const lastDot = key.lastIndexOf(".");
	if (lastDot > lastSlash) return key.slice(0, lastDot);
	return key;
}

const key = mediaKey(image);
const avifId = key ? keyWithoutExtension(key) : null;
const metadata = avifId
	? (mediaImageMetadata as Record<string, ImageMetadata | undefined>)[avifId]
	: undefined;
const fallbackWidth = width ?? mediaWidth(image) ?? metadata?.width;
const fallbackHeight = height ?? mediaHeight(image) ?? metadata?.height;
const fallbackSrc = mediaSrc(image, key);
const directLocalImage = !!(
	fallbackSrc &&
	fallbackWidth &&
	fallbackHeight &&
	(fallbackSrc.startsWith("/") || fallbackSrc.includes("/_emdash/api/media/file/"))
);
const avifSrcset = avifId && metadata?.widths.length
	? metadata.widths
		.map((variantWidth) => `/_emdash/api/media/file/derivatives/${avifId}/${variantWidth}.avif ${variantWidth}w`)
		.join(", ")
	: undefined;
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : undefined;
---

{
	avifSrcset && directLocalImage ? (
		<picture class:list={["responsive-image", className]}>
			<source type="image/avif" srcset={avifSrcset} sizes={sizes} />
			<img
				src={fallbackSrc}
				alt={alt}
				width={fallbackWidth}
				height={fallbackHeight}
				loading={loading}
				fetchpriority={fetchpriority}
				decoding="async"
				class="emdash-image-media"
			/>
		</picture>
	) : directLocalImage ? (
		<img
			src={fallbackSrc}
			alt={alt}
			width={fallbackWidth}
			height={fallbackHeight}
			loading={loading}
			fetchpriority={fetchpriority}
			decoding="async"
			class:list={["emdash-image-media", className]}
		/>
	) : (
		<Image
			image={image}
			alt={alt}
			width={fallbackWidth}
			height={fallbackHeight}
			priority={priority}
			loading={loading}
			fetchpriority={fetchpriority}
			decoding="async"
			class={className}
		/>
	)
}
