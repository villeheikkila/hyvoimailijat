---
interface Props {
	label: string;
	title: string;
	count?: string | number;
	class?: string;
}

const { label, title, count, class: className } = Astro.props;
---

<section class:list={["archive-shell", className]}>
	<header class="archive-shell__header">
		<span class="archive-shell__label">{label}</span>
		<h1 class="archive-shell__title">{title}</h1>
		{count !== undefined && <p class="archive-shell__count">{count}</p>}
	</header>

	<slot />
</section>

<style>
	.archive-shell {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--layout-margin) var(--spacing-16);
	}

	.archive-shell__header {
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-5);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-shell__label {
		display: block;
		margin-bottom: var(--spacing-2);
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
	}

	.archive-shell__title {
		margin-bottom: var(--spacing-2);
		font-size: var(--title-page-compact);
		font-weight: var(--font-weight-display);
		letter-spacing: 0;
	}

	.archive-shell__count {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}
</style>
