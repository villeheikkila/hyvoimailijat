---
export const prerender = false;

import type { PortableTextBlock } from "emdash";
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { getPlainText } from "../utils/club-pages";

interface Props {
	lang: "fi" | "en";
}

const { lang } = Astro.props;
const query = Astro.url.searchParams.get("q")?.trim() || "";

Astro.cache?.set(false);
Astro.response.headers.set("Cache-Control", "private, no-store");

type SearchResult = {
	title: string;
	href: string;
	snippet: string;
	score: number;
};

const copy = {
	fi: {
		title: "Haku",
		description: "Hae sivuston artikkeleista ja sivuista",
		placeholder: "Hae sivustolta...",
		button: "Hae",
		hint: "Kirjoita hakusana löytääksesi sisältöä.",
		noResults: (term: string) => `Ei tuloksia haulle "${term}"`,
		summary: (count: number, term: string) =>
			`${count} ${count === 1 ? "tulos" : "tulosta"} haulle "${term}"`,
	},
	en: {
		title: "Search",
		description: "Search site articles and pages",
		placeholder: "Search the site...",
		button: "Search",
		hint: "Type a search term to find content.",
		noResults: (term: string) => `No results for "${term}"`,
		summary: (count: number, term: string) =>
			`${count} ${count === 1 ? "result" : "results"} for "${term}"`,
	},
}[lang];

const pageRoutes: Record<"fi" | "en", Record<string, string>> = {
	fi: {
		seura: "/seura",
		"liity-jaseneksi": "/liity-jaseneksi",
		"hyv-voimaliiga-saannot": "/hyv-voimaliiga-saannot",
		ranking: "/ranking",
		"tulokset-3": "/tulokset",
		uutiset: "/posts",
	},
	en: {
		about: "/en/about",
		"become-a-member": "/en/become-a-member",
		rules: "/en/rules",
		ranking: "/en/ranking",
		"ranking-en": "/en/ranking",
		results: "/en/results",
		news: "/posts",
	},
};

const normalize = (value: string) =>
	value
		.toLocaleLowerCase(lang === "fi" ? "fi-FI" : "en-GB")
		.normalize("NFD")
		.replace(/\p{Diacritic}/gu, "");

function makeSnippet(text: string, term: string) {
	const clean = text.replace(/\s+/g, " ").trim();
	if (!clean) return "";

	const normalizedText = normalize(clean);
	const normalizedTerm = normalize(term);
	const index = normalizedText.indexOf(normalizedTerm);
	const start = index === -1 ? 0 : Math.max(0, index - 80);
	const end = Math.min(clean.length, start + 220);
	const prefix = start > 0 ? "..." : "";
	const suffix = end < clean.length ? "..." : "";
	const excerpt = `${prefix}${clean.slice(start, end)}${suffix}`;

	return escapeHtml(excerpt).replace(
		new RegExp(escapeRegExp(term), "giu"),
		(match) => `<mark>${match}</mark>`,
	);
}

function escapeHtml(value: string) {
	return value
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
}

function escapeRegExp(value: string) {
	return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function scoreResult(title: string, body: string, term: string) {
	const normalizedTitle = normalize(title);
	const normalizedBody = normalize(body);
	const normalizedTerm = normalize(term);
	let score = 0;
	if (normalizedTitle.includes(normalizedTerm)) score += 10;
	if (normalizedTitle.startsWith(normalizedTerm)) score += 5;
	if (normalizedBody.includes(normalizedTerm)) score += 1;
	return score;
}

let results: SearchResult[] = [];

if (query) {
	const [{ entries: posts }, { entries: pages }] =
		await Promise.all([
			getEmDashCollection("posts", {
				status: "published",
				locale: lang,
				orderBy: { published_at: "desc" },
				limit: 500,
			}),
			getEmDashCollection("pages", {
				status: "published",
				locale: lang,
				orderBy: { updated_at: "desc" },
				limit: 200,
			}),
		]);

	const postResults = posts.map((post): SearchResult | null => {
		const contentText = getPlainText(post.data.content as PortableTextBlock[]);
		const searchableText = `${post.data.title} ${post.data.excerpt ?? ""} ${contentText}`;
		const score = scoreResult(post.data.title, searchableText, query);
		if (score === 0) return null;

		return {
			title: post.data.title,
			href: `/posts/${post.id}`,
			snippet: makeSnippet(post.data.excerpt || contentText, query),
			score,
		};
	});

	const pageResults = pages.map((page): SearchResult | null => {
		const href = pageRoutes[lang][page.id];
		if (!href) return null;

		const contentText = getPlainText(page.data.content as PortableTextBlock[]);
		const searchableText = `${page.data.title} ${contentText}`;
		const score = scoreResult(page.data.title, searchableText, query);
		if (score === 0) return null;

		return {
			title: page.data.title,
			href,
			snippet: makeSnippet(contentText, query),
			score,
		};
	});

	results = [...postResults, ...pageResults]
		.filter((result): result is SearchResult => result !== null)
		.sort((a, b) => b.score - a.score || a.title.localeCompare(b.title, lang === "fi" ? "fi-FI" : "en-GB"))
		.slice(0, 30);
}
---

<Base
	title={query ? `${copy.title}: ${query}` : copy.title}
	description={copy.description}
	robots="noindex,follow"
	lang={lang}
>
	<section class="search-page">
		<header class="search-header">
			<h1 class="search-title">{copy.title}</h1>
		</header>

		<form method="get" action={lang === "fi" ? "/search" : "/en/search"} class="search-form">
			<input
				type="search"
				name="q"
				value={query}
				placeholder={copy.placeholder}
				class="search-input"
				autofocus
			/>
			<button type="submit" class="search-button">{copy.button}</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0 ? copy.noResults(query) : copy.summary(results.length, query)}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result) => (
						<li class="search-result">
							<a href={result.href} class="result-link">
								<h2 class="result-title">{result.title}</h2>
								{result.snippet && (
									<p class="result-snippet" set:html={result.snippet} />
								)}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="search-hint">{copy.hint}</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-16);
	}

	.search-header {
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-5);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-title {
		font-size: var(--title-page-compact);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: 0;
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.search-input {
		flex: 1;
		min-width: 0;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-brand);
	}

	.search-button {
		padding: var(--spacing-2) var(--spacing-6);
		font-size: var(--font-size-base);
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 500;
	}

	.search-button:hover {
		opacity: 0.9;
	}

	.search-summary,
	.search-hint {
		color: var(--color-muted);
	}

	.search-summary {
		margin-bottom: var(--spacing-6);
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.search-result {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-result:first-child {
		padding-top: 0;
	}

	.search-result:last-child {
		border-bottom: none;
	}

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.result-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.result-link:hover .result-title {
		color: var(--color-brand);
	}

	.result-snippet {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: inherit;
		padding: 0 0.1em;
		border-radius: 2px;
	}

	@media (max-width: 520px) {
		.search-form {
			flex-direction: column;
		}

		.search-button {
			width: 100%;
		}
	}
</style>
