---
import type { PortableTextBlock } from "emdash";
import { parseTableFromPortableText } from "../utils/club-pages";

interface TableEntry {
	data: {
		title?: string;
		content?: PortableTextBlock[];
	};
}

interface Props {
	tables: TableEntry[];
}

const { tables } = Astro.props;
const parsedTables = tables
	.map((entry) => ({
		title: entry.data.title ?? "Ranking",
		rows: parseTableFromPortableText(entry.data.content),
	}))
	.filter((table) => table.rows.length > 1)
	.map((table) => ({
		...table,
		rows: table.rows.filter((row) => row.some(Boolean)),
	}));
---

<div class="ranking-stack">
	{
		parsedTables.map((table) => (
			<section class="ranking-block">
				<header>
					<h2>{table.title}</h2>
				</header>
				<div class="table-scroll">
					<table class="ranking-table">
						<thead>
							<tr>
								{table.rows[0].map((cell, index) => (
									<th>
										<button
											type="button"
											class="ranking-sort"
											data-column={index}
											aria-label={`Järjestä sarakkeen ${cell} mukaan`}
										>
											<span>{cell}</span>
											<span class="ranking-sort-indicator" aria-hidden="true"></span>
										</button>
									</th>
								))}
							</tr>
						</thead>
						<tbody>
							{table.rows.slice(1).map((row) => (
								<tr>
									{row.map((cell) => <td>{cell}</td>)}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		))
	}
</div>

<script>
	function getCellValue(row: HTMLTableRowElement, column: number) {
		return row.cells[column]?.textContent?.trim() ?? "";
	}

	function parseSortableValue(value: string) {
		const normalized = value.replace(/\s/g, "").replace(",", ".");
		if (/^-?\d+(?:\.\d+)?$/.test(normalized)) {
			return { type: "number", value: Number(normalized) };
		}

		const date = value.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
		if (date) {
			return {
				type: "number",
				value: Number(`${date[3]}${date[2].padStart(2, "0")}${date[1].padStart(2, "0")}`),
			};
		}

		return { type: "text", value: value.toLocaleLowerCase("fi-FI") };
	}

	function compareValues(left: string, right: string) {
		const a = parseSortableValue(left);
		const b = parseSortableValue(right);

		if (a.type === "number" && b.type === "number") {
			return Number(a.value) - Number(b.value);
		}

		return String(a.value).localeCompare(String(b.value), "fi-FI", {
			numeric: true,
			sensitivity: "base",
		});
	}

	document.querySelectorAll<HTMLTableElement>(".ranking-table").forEach((table) => {
		const tbody = table.tBodies[0];
		if (!tbody) return;

		table.querySelectorAll<HTMLButtonElement>(".ranking-sort").forEach((button) => {
			button.addEventListener("click", () => {
				const column = Number(button.dataset.column ?? 0);
				const current = button.closest("th")?.getAttribute("aria-sort");
				const direction = current === "ascending" ? "descending" : "ascending";
				const multiplier = direction === "ascending" ? 1 : -1;
				const rows = Array.from(tbody.rows);

				rows
					.map((row, index) => ({ row, index }))
					.sort((left, right) => {
						const result =
							compareValues(
								getCellValue(left.row, column),
								getCellValue(right.row, column)
							) * multiplier;
						return result === 0 ? left.index - right.index : result;
					})
					.forEach(({ row }) => tbody.appendChild(row));

				table.querySelectorAll<HTMLTableCellElement>("th").forEach((header) => {
					header.removeAttribute("aria-sort");
				});
				table.querySelectorAll<HTMLButtonElement>(".ranking-sort").forEach((sort) => {
					sort.removeAttribute("data-sort-direction");
				});
				button.closest("th")?.setAttribute("aria-sort", direction);
				button.setAttribute("data-sort-direction", direction);
			});
		});
	});
</script>
