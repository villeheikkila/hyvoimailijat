---
import { blockComponents } from "@emdash-cms/plugin-forms/astro";
import type { Locale } from "../utils/club-pages";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const FormEmbed = blockComponents["emdash-form"];
const formId = lang === "fi" ? "contact-fi" : "contact-en";
const heading = lang === "fi" ? "Ota yhteyttä" : "Contact";
---

<section class="application-panel">
	<h2 class="panel-heading">{heading}</h2>
	{FormEmbed && <FormEmbed node={{ formId }} />}
</section>
