---
import { PortableText } from "emdash/ui";
import type { MediaValue, PortableTextBlock } from "emdash";
import { getBlockParts, getEmbedUrl, isInvalidFileBlock } from "../utils/embeds";
import HyvLogo from "./HyvLogo.astro";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
	value?: PortableTextBlock[];
	replaceImagesWithLogo?: boolean;
	priorityFirstImage?: boolean;
}

const {
	value = [],
	replaceImagesWithLogo = false,
	priorityFirstImage = false,
} = Astro.props;

type RenderItem =
	| { type: "blocks"; blocks: PortableTextBlock[] }
	| { type: "logo" }
	| { type: "image"; image: MediaValue; caption?: string; priority: boolean; isFirstImage: boolean }
	| { type: "embed"; embed: { type: string; url: string; title: string } }
	| { type: "table"; title: string; columns: string[]; rows: string[][] }
	| { type: "video"; src: string }
	| { type: "link"; href: string; label: string };

type PortableTextSpan = {
	_key?: string;
	text?: string;
	marks?: string[];
};

function isImageBlock(block: PortableTextBlock): boolean {
	const candidate = block as unknown as { _type?: string; type?: string };
	return candidate._type === "image" || candidate.type === "image";
}

function blockType(block: PortableTextBlock): string | undefined {
	const candidate = block as unknown as { _type?: string; type?: string };
	return candidate._type ?? candidate.type;
}

function imageBlockToMediaValue(block: PortableTextBlock): MediaValue | null {
	const candidate = block as unknown as {
		asset?: {
			_ref?: string;
			url?: string;
			meta?: Record<string, unknown>;
		};
		alt?: string;
		width?: number;
		height?: number;
	};
	const url = candidate.asset?.url ?? candidate.asset?._ref;
	if (!url) return null;

	const localPrefix = "/_emdash/api/media/file/";
	const localIndex = url.indexOf(localPrefix);
	const storageKey = localIndex === -1 ? url : url.slice(localIndex + localPrefix.length);

	return {
		provider: url.startsWith("http") ? "external" : "local",
		id: storageKey,
		src: url,
		alt: candidate.alt,
		width: candidate.width,
		height: candidate.height,
		meta: candidate.asset?.meta,
	};
}

function imageCaption(block: PortableTextBlock): string | undefined {
	const candidate = block as unknown as { caption?: unknown };
	return typeof candidate.caption === "string" && candidate.caption.trim() ? candidate.caption.trim() : undefined;
}

function blockChildren(block: PortableTextBlock): PortableTextSpan[] {
	const candidate = block as unknown as { _type?: string; type?: string; children?: PortableTextSpan[] };
	if ((candidate._type ?? candidate.type) !== "block" || !Array.isArray(candidate.children)) return [];
	return candidate.children;
}

function normalizeCell(value: string): string {
	return value.replace(/\u00a0/g, " ").replace(/\s+/g, " ").trim();
}

function isStrongSpan(span: PortableTextSpan): boolean {
	return Array.isArray(span.marks) && span.marks.includes("strong");
}

function isLikelyTableTitle(value: string): boolean {
	return /^(Tulokset|TULOKSET|Miehet|Naiset|Pistetilanne|Voimaliigan tilanne|Jalkakyykky|Kyykky|Penkki|Veto|Maastaveto)/i.test(value);
}

function isKnownTableHeader(value: string): boolean {
	return /^(Sija|Sijoitus|Nimi|Paino|Lisäpaino|Yhteistulos|yhteistulos|Yht\.?|Tulos|Pisteet|Toistot|Toistokisan|Ero|Wilks|WILKS|KERROIN|PAINO|TULOS|SIJOITUS|Kuulantyöntö|Köydenveto|Farmarikävely|Lastaus|Pystypunnerrus|Kahvakuulatyöntö|Omapaino|Lisäpainot)/i.test(value);
}

function isRankCell(value: string): boolean {
	return /^\d+\.?$/.test(value);
}

function firstLegacyTableIndex(cells: Array<{ text: string; strong: boolean }>): number {
	return cells.findIndex((cell, index) => {
		const strongHeaderRun = cells.slice(index, index + 8).filter((next) => next.strong).length >= 2;
		if (!cell.strong && !isLikelyTableTitle(cell.text) && !strongHeaderRun && !isKnownTableHeader(cell.text)) return false;
		const lookahead = cells.slice(index + 1, index + 8).map((next) => next.text);
		const numericHeaderRun = lookahead.slice(0, 3).every((next) => isRankCell(next));
		return lookahead.some(isKnownTableHeader) || strongHeaderRun || numericHeaderRun;
	});
}

function collectTableColumns(
	cells: Array<{ text: string; strong: boolean }>,
	startIndex: number,
	previousColumns: string[] | null,
): { columns: string[] | null; nextIndex: number } {
	const headers: string[] = [];
	let index = startIndex;

	while (index < cells.length && (isKnownTableHeader(cells[index].text) || isRankCell(cells[index].text))) {
		headers.push(cells[index].text);
		index += 1;
	}

	if (headers.length === 0) {
		while (index < cells.length && cells[index].strong && !isRankCell(cells[index].text)) {
			headers.push(cells[index].text);
			index += 1;
		}
	}

	if (headers.length === 0) {
		const rankIndex = cells.slice(index, index + 12).findIndex((cell) => isRankCell(cell.text));
		if (rankIndex > 1) {
			headers.push(...cells.slice(index, index + rankIndex).map((cell) => cell.text));
			index += rankIndex;
		}
	}

	if (headers.length > 0) {
		return {
			columns: headers.some((header) => /^Nimi$/i.test(header)) ? headers : ["Nimi", ...headers],
			nextIndex: index,
		};
	}

	return { columns: previousColumns, nextIndex: startIndex };
}

function isSectionBoundary(cells: Array<{ text: string; strong: boolean }>, index: number): boolean {
	const cell = cells[index];
	if (!cell) return true;
	if (/^(Teksti|Kuva|Video):/i.test(cell.text)) return true;
	if (cell.strong && isLikelyTableTitle(cell.text)) return true;
	if (isLikelyTableTitle(cell.text)) {
		const lookahead = cells.slice(index + 1, index + 8).map((next) => next.text);
		const numericHeaderRun = lookahead.slice(0, 3).every((next) => isRankCell(next));
		if (lookahead.some(isKnownTableHeader) || numericHeaderRun) return true;
	}
	if (isKnownTableHeader(cell.text)) {
		const headerRun = cells.slice(index, index + 4).filter((next) => isKnownTableHeader(next.text)).length;
		if (headerRun >= 2) return true;
	}
	return false;
}

function splitLegacyResultTables(block: PortableTextBlock): RenderItem[] | null {
	const children = blockChildren(block);
	if (children.length < 12) return null;

	const cells = children
		.map((span) => ({ span, text: normalizeCell(span.text ?? ""), strong: isStrongSpan(span) }))
		.filter((cell) => cell.text);
	const firstTableIndex = firstLegacyTableIndex(cells);
	if (firstTableIndex === -1) return null;

	const items: RenderItem[] = [];
	const firstTableSpan = cells[firstTableIndex].span;
	const firstChildIndex = children.indexOf(firstTableSpan);
	const introChildren = children.slice(0, firstChildIndex).filter((span) => normalizeCell(span.text ?? ""));

	if (introChildren.length > 0) {
		items.push({
			type: "blocks",
			blocks: [{ ...(block as object), children: introChildren } as unknown as PortableTextBlock],
		});
	}

	let columns: string[] | null = null;
	let index = firstTableIndex;

	while (index < cells.length) {
		let title = "Tulokset";
		if (cells[index].strong || isLikelyTableTitle(cells[index].text)) {
			const lookahead = cells.slice(index + 1, index + 8).map((next) => next.text);
			if (lookahead.some(isKnownTableHeader) || isLikelyTableTitle(cells[index].text)) {
				title = cells[index].text.replace(/:$/, "");
				index += 1;
			}
		}

		const columnResult = collectTableColumns(cells, index, columns);
		columns = columnResult.columns;
		index = columnResult.nextIndex;
		if (!columns || columns.length === 0) continue;

		const rows: string[][] = [];
		while (index < cells.length && !isSectionBoundary(cells, index)) {
			if (cells.length - index < columns.length) break;
			const row = cells.slice(index, index + columns.length).map((cell) => cell.text);
			if (columns[0] === "Sijoitus" && !isRankCell(row[0])) break;
			rows.push(row);
			index += columns.length;
		}

		if (rows.length > 0) {
			items.push({ type: "table", title, columns, rows });
		} else {
			break;
		}
	}

	return items.some((item) => item.type === "table") ? items : null;
}

function legacyEmbedItem(block: PortableTextBlock): RenderItem | null {
	const candidate = block as unknown as { url?: string; provider?: string };
	if (!candidate.url) return null;

	const embed = getEmbedUrl(candidate.url);
	if (embed) return { type: "embed", embed };

	return { type: "link", href: candidate.url, label: candidate.provider ?? candidate.url };
}

function legacyHtmlItem(block: PortableTextBlock): RenderItem | null {
	const html = (block as unknown as { html?: string }).html ?? "";
	const videoMatch = html.match(/<video[^>]+src=["']([^"']+)["']/i);
	if (videoMatch?.[1]) {
		return { type: "video", src: videoMatch[1] };
	}

	const linkMatch = html.match(/<a[^>]+href=["']([^"']+)["'][^>]*>(.*?)<\/a>/is);
	if (linkMatch?.[1]) {
		const label = normalizeCell(linkMatch[2].replace(/<[^>]+>/g, "")) || linkMatch[1];
		return { type: "link", href: linkMatch[1], label };
	}

	const textUrl = html.match(/https?:\/\/[^\s<>"')]+/i)?.[0];
	if (textUrl) {
		const embed = getEmbedUrl(textUrl);
		return embed ? { type: "embed", embed } : { type: "link", href: textUrl, label: textUrl };
	}

	return null;
}

function buildRenderItems(blocks: PortableTextBlock[]): RenderItem[] {
	const items: RenderItem[] = [];
	let pendingBlocks: PortableTextBlock[] = [];
	let didPrioritizeImage = false;
	let didRenderImage = false;

	const flushBlocks = () => {
		if (pendingBlocks.length > 0) {
			items.push({ type: "blocks", blocks: pendingBlocks });
			pendingBlocks = [];
		}
	};

	for (const block of blocks) {
		if (isInvalidFileBlock(block)) continue;

		if (blockType(block) === "embed") {
			const item = legacyEmbedItem(block);
			if (item) {
				flushBlocks();
				items.push(item);
				continue;
			}
		}

		if (blockType(block) === "htmlBlock") {
			const item = legacyHtmlItem(block);
			if (item) {
				flushBlocks();
				items.push(item);
				continue;
			}
		}

		if (replaceImagesWithLogo && isImageBlock(block)) {
			flushBlocks();
			items.push({ type: "logo" });
			continue;
		}

		if (isImageBlock(block)) {
			const image = imageBlockToMediaValue(block);
			const caption = imageCaption(block);
			const priority = priorityFirstImage && !didPrioritizeImage;
			const isFirstImage = !didRenderImage;
			didPrioritizeImage = true;
			didRenderImage = true;
			if (!image) continue;

			flushBlocks();
			items.push({ type: "image", image, caption, priority, isFirstImage });
			continue;
		}

		const legacyTableItems = splitLegacyResultTables(block);
		if (legacyTableItems) {
			flushBlocks();
			items.push(...legacyTableItems);
			continue;
		}

		for (const part of getBlockParts(block)) {
			if (part.type === "block") {
				pendingBlocks.push(part.block);
				continue;
			}

			flushBlocks();
			items.push({ type: "embed", embed: part.embed });
		}
	}

	flushBlocks();
	return items;
}

const renderItems = buildRenderItems(value);
---

{
	renderItems.map((item) => {
		if (item.type === "blocks") {
			return <PortableText value={item.blocks} />;
		}

		if (item.type === "logo") {
			return (
				<div class="about-content-logo" aria-hidden="true">
					<HyvLogo class="about-content-logo-img" />
				</div>
			);
		}

		if (item.type === "image") {
			return (
				<figure>
					<ResponsiveImage
						image={item.image}
						alt={item.image.alt}
						priority={item.priority}
						class={item.isFirstImage ? "article-image article-image--lead" : "article-image"}
						sizes="(max-width: 900px) 100vw, 680px"
					/>
					{item.caption && <figcaption>{item.caption}</figcaption>}
				</figure>
			);
		}

		if (item.type === "table") {
			return (
				<section class="legacy-result-table">
					<h3>{item.title}</h3>
					<div class="legacy-result-table__scroll">
						<table>
							<thead>
								<tr>
									{item.columns.map((column) => (
										<th scope="col">{column}</th>
									))}
								</tr>
							</thead>
							<tbody>
								{item.rows.map((row) => (
									<tr>
										{row.map((cell) => (
											<td>{cell}</td>
										))}
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			);
		}

		if (item.type === "video") {
			return (
				<video class="legacy-video" controls preload="metadata">
					<source src={item.src} />
				</video>
			);
		}

		if (item.type === "link") {
			return (
				<p class="legacy-link">
					<a href={item.href}>{item.label}</a>
				</p>
			);
		}

		return (
			<div class:list={["rich-embed", `rich-embed--${item.embed.type}`]}>
				<iframe
					src={item.embed.url}
					title={item.embed.title}
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				/>
			</div>
		);
	})
}

<style>
	.legacy-result-table {
		margin: 2em 0;
	}

	.legacy-result-table h3 {
		margin: 0 0 var(--spacing-3);
		font-size: var(--font-size-xl);
	}

	.legacy-result-table__scroll {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: 0;
	}

	.legacy-result-table table {
		width: 100%;
		min-width: 28rem;
		border-collapse: collapse;
		font-size: 0.95em;
	}

	.legacy-result-table th,
	.legacy-result-table td {
		padding: var(--spacing-3) var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
		text-align: left;
		white-space: nowrap;
	}

	.legacy-result-table th {
		color: var(--color-text);
		background: var(--color-bg-subtle);
		font-weight: 700;
	}

	.legacy-result-table tbody tr:last-child td {
		border-bottom: 0;
	}

	.legacy-video {
		display: block;
		width: 100%;
		max-width: 100%;
		margin: 2em 0;
		border-radius: 0;
		background: var(--color-surface);
	}

	.legacy-link {
		margin: 1.5em 0;
	}
</style>
