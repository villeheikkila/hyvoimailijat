---
import {
	EmDashBodyEnd,
	EmDashBodyStart,
	EmDashHead,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import HyvLogo from "../components/HyvLogo.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	lang?: "fi" | "en";
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	lang = Astro.url.pathname.startsWith("/en") ? "en" : "fi",
	content,
} = Astro.props;

const siteTitle = "Helsingin Yliopiston Voimailijat";
const siteLogoSrc = "/hyv-logo.svg";
const fullTitle = title.includes(siteTitle) ? title : `${title} - ${siteTitle}`;
const copyright = `© ${new Date().getFullYear()} Helsingin Yliopiston Voimailijat ry`;

const nav =
	lang === "fi"
		? [
				{ href: "/", label: "Etusivu" },
				{ href: "/posts", label: "Uutiset" },
				{ href: "/tulokset", label: "Tulokset" },
				{ href: "/hyv-voimaliiga-saannot", label: "Voimaliiga" },
				{ href: "/seura", label: "Seura" },
				{ href: "/liity-jaseneksi", label: "Liity" },
				{ href: "/ranking", label: "Ranking" },
			]
		: [
				{ href: "/en", label: "Home" },
				{ href: "/posts", label: "News" },
				{ href: "/en/results", label: "Results" },
				{ href: "/en/rules", label: "Rules" },
				{ href: "/en/about", label: "About" },
				{ href: "/en/become-a-member", label: "Join" },
				{ href: "/en/ranking", label: "Ranking" },
			];

const langHref = lang === "fi" ? "/en" : "/";
const langLabel = lang === "fi" ? "EN" : "FI";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/svg+xml" href="/hyv-logo.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav" aria-label={lang === "fi" ? "Päävalikko" : "Primary"}>
				<a href={lang === "fi" ? "/" : "/en"} class="site-title">
					<HyvLogo class="site-logo-img" />
					<span class="site-name">Helsingin Yliopiston Voimailijat</span>
				</a>
				<div class="nav-right">
					<div class="nav-links">
						{nav.map((item) => <a href={item.href}>{item.label}</a>)}
					</div>
					<a href={langHref} class="lang-switch">{langLabel}</a>
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
					<label class="theme-toggle" aria-label={lang === "fi" ? "Vaihda teemaa" : "Toggle theme"}>
						<span class="sr-only">{lang === "fi" ? "Vaihda teemaa" : "Toggle theme"}</span>
						<input type="checkbox" class="theme-toggle-input" aria-label={lang === "fi" ? "Vaihda teemaa" : "Toggle theme"} />
						<span class="theme-toggle-track" aria-hidden="true">
							<svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 24 24">
								<circle cx="12" cy="12" r="3.5"></circle>
								<path d="M12 2.5v2M12 19.5v2M4.57 4.57l1.42 1.42M18.01 18.01l1.42 1.42M2.5 12h2M19.5 12h2M4.57 19.43l1.42-1.42M18.01 5.99l1.42-1.42"></path>
							</svg>
							<span class="theme-toggle-thumb"></span>
							<svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 24 24">
								<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
							</svg>
						</span>
					</label>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<a href={lang === "fi" ? "/" : "/en"} class="footer-logo" aria-label={siteTitle}>
						<HyvLogo class="footer-logo-img" />
					</a>
					<p>{copyright}</p>
				</div>
			</div>
		</footer>

		<script>
			const THEME_REGEX = /theme=([^;]+)/;
			const themeToggle =
				document.querySelector<HTMLInputElement>(".theme-toggle-input");
			const root = document.documentElement;

			function setCookie(name: string, value: string, maxAge = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				setCookie("theme", theme);
				root.classList.remove("light", "dark");
				root.classList.add(theme);
				if (themeToggle) themeToggle.checked = theme === "dark";
			}

			const match = document.cookie.match(THEME_REGEX);
			const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
				? "dark"
				: "light";
			setTheme(match && (match[1] === "light" || match[1] === "dark") ? match[1] : systemTheme);
			themeToggle?.addEventListener("change", () =>
				setTheme(themeToggle.checked ? "dark" : "light")
			);
		</script>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
