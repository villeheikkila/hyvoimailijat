---
import { getSiteSettings } from "emdash";
import {
	EmDashBodyEnd,
	EmDashBodyStart,
	EmDashHead,
	WidgetArea,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	lang?: "fi" | "en";
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	lang = Astro.url.pathname.startsWith("/en") ? "en" : "fi",
	content,
} = Astro.props;

const { siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
const siteTitle = "Helsingin Yliopiston Voimailijat";
const siteTagline =
	lang === "fi"
		? "Opiskelijoiden voimailuseura Helsingissä"
		: "Student strength sports club in Helsinki";
const fullTitle = title.includes(siteTitle) ? title : `${title} - ${siteTitle}`;

const nav =
	lang === "fi"
		? [
				{ href: "/", label: "Etusivu" },
				{ href: "/seura", label: "Seura" },
				{ href: "/liity-jaseneksi", label: "Liity" },
				{ href: "/hyv-voimaliiga-saannot", label: "Voimaliiga" },
				{ href: "/ranking", label: "Ranking" },
				{ href: "/posts", label: "Uutiset" },
			]
		: [
				{ href: "/en", label: "Home" },
				{ href: "/en/about", label: "About" },
				{ href: "/en/become-a-member", label: "Join" },
				{ href: "/en/rules", label: "Rules" },
				{ href: "/en/ranking", label: "Ranking" },
				{ href: "/posts", label: "News" },
			];

const langHref = lang === "fi" ? "/en" : "/";
const langLabel = lang === "fi" ? "EN" : "FI";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav" aria-label={lang === "fi" ? "Päävalikko" : "Primary"}>
				<a href={lang === "fi" ? "/" : "/en"} class="site-title">
					{siteLogo ? (
						<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" />
					) : (
						<span class="site-mark">HYV</span>
					)}
					<span class="site-name">Helsingin Yliopiston Voimailijat</span>
				</a>
				<div class="nav-right">
					<div class="nav-links">
						{nav.map((item) => <a href={item.href}>{item.label}</a>)}
					</div>
					<a href={langHref} class="lang-switch">{langLabel}</a>
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<a href={lang === "fi" ? "/" : "/en"} class="footer-logo">HYV</a>
					<p>{siteTagline}</p>
				</div>
				<nav class="footer-links" aria-label={lang === "fi" ? "Alavalikko" : "Footer"}>
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
					<a href="/rss.xml">RSS</a>
				</nav>
				<div class="theme-switcher" aria-label="Theme">
					<button type="button" class="theme-btn" data-theme="light" aria-label="Light mode">L</button>
					<button type="button" class="theme-btn" data-theme="dark" aria-label="Dark mode">D</button>
					<button type="button" class="theme-btn" data-theme="system" aria-label="System theme">A</button>
				</div>
				<WidgetArea name="footer" />
			</div>
		</footer>

		<script>
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(name: string, value: string, maxAge = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					btn.classList.toggle("active", btn.dataset.theme === theme);
				});
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			const match = document.cookie.match(THEME_REGEX);
			setTheme(match ? match[1] : "system");
			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => setTheme(btn.dataset.theme || "system"));
			});
		</script>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
