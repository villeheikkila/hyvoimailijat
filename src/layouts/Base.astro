---
import {
	EmDashBodyEnd,
	EmDashBodyStart,
	EmDashHead,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import HyvLogo from "../components/HyvLogo.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	lang?: "fi" | "en";
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	lang = Astro.url.pathname.startsWith("/en") ? "en" : "fi",
	content,
} = Astro.props;

const siteTitle = "Helsingin Yliopiston Voimailijat";
const fullTitle = title.includes(siteTitle) ? title : `${title} - ${siteTitle}`;
const copyright = `© ${new Date().getFullYear()} Helsingin Yliopiston Voimailijat ry`;

const nav =
	lang === "fi"
		? [
				{ href: "/", label: "Etusivu" },
				{ href: "/posts", label: "Uutiset" },
				{ href: "/tulokset", label: "Tulokset" },
				{ href: "/hyv-voimaliiga-saannot", label: "Voimaliiga" },
				{ href: "/seura", label: "Seura" },
				{ href: "/liity-jaseneksi", label: "Liity" },
				{ href: "/ranking", label: "Ranking" },
			]
		: [
				{ href: "/en", label: "Home" },
				{ href: "/posts", label: "News" },
				{ href: "/en/results", label: "Results" },
				{ href: "/en/rules", label: "Rules" },
				{ href: "/en/about", label: "About" },
				{ href: "/en/become-a-member", label: "Join" },
				{ href: "/en/ranking", label: "Ranking" },
			];

const langHref = lang === "fi" ? "/en" : "/";
const langLabel = lang === "fi" ? "EN" : "FI";
const langSwitchLabel = lang === "fi" ? "Switch to English" : "Vaihda suomeksi";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/svg+xml" href="/hyv-logo.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(function () {
				var match = document.cookie.match(/(?:^|;\s*)theme=(light|dark)(?:;|$)/);
				var theme = match ? match[1] : null;
				if (theme !== "dark" && theme !== "light") {
					theme = window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light";
				}
				document.documentElement.classList.remove("light", "dark");
				document.documentElement.classList.add(theme);
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav" aria-label={lang === "fi" ? "Päävalikko" : "Primary"}>
				<div class="nav-brand">
					<details class="nav-menu">
						<summary class="nav-menu-button" aria-label={lang === "fi" ? "Avaa valikko" : "Open navigation menu"}>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M4 6h16M4 12h10M4 18h16"></path>
							</svg>
						</summary>
						<div class="nav-menu-panel">
							{nav.map((item) => <a href={item.href}>{item.label}</a>)}
						</div>
					</details>
					<a href={lang === "fi" ? "/" : "/en"} class="site-title" aria-label={siteTitle}>
						<HyvLogo class="site-logo-img" />
					</a>
				</div>
				<div class="nav-links nav-links-desktop">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</div>
				<div class="nav-actions">
					<a href="/search" class="nav-search" aria-label={lang === "fi" ? "Hae" : "Search"}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"></path>
						</svg>
					</a>
					<a href={langHref} class="lang-switch" aria-label={langSwitchLabel} title={langSwitchLabel}>
						<span class="sr-only">{langSwitchLabel}</span>
						<span aria-hidden="true">{langLabel}</span>
					</a>
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
					<button class="theme-toggle" type="button" aria-label={lang === "fi" ? "Vaihda teemaa" : "Toggle theme"}>
						<span class="sr-only">{lang === "fi" ? "Vaihda teemaa" : "Toggle theme"}</span>
						<svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="3.5"></circle>
							<path d="M12 2.5v2M12 19.5v2M4.57 4.57l1.42 1.42M18.01 18.01l1.42 1.42M2.5 12h2M19.5 12h2M4.57 19.43l1.42-1.42M18.01 5.99l1.42-1.42"></path>
						</svg>
						<svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
						</svg>
					</button>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<a href={lang === "fi" ? "/" : "/en"} class="footer-logo" aria-label={siteTitle}>
						<HyvLogo class="footer-logo-img" />
					</a>
					<p>{copyright}</p>
				</div>
				<nav class="footer-social" aria-label={lang === "fi" ? "Sosiaalinen media" : "Social media"}>
					<a href="https://www.facebook.com/hyvoimailijat" target="_blank" rel="me noopener noreferrer" aria-label="Facebook">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.92 3.78-3.92 1.1 0 2.24.2 2.24.2v2.48H15.2c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06Z"></path>
						</svg>
					</a>
					<a href="https://www.instagram.com/hyvoima/" target="_blank" rel="me noopener noreferrer" aria-label="Instagram">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M7.8 2h8.4C19.41 2 22 4.59 22 7.8v8.4c0 3.21-2.59 5.8-5.8 5.8H7.8C4.59 22 2 19.41 2 16.2V7.8C2 4.59 4.59 2 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8c1.99 0 3.6-1.61 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"></path>
						</svg>
					</a>
				</nav>
			</div>
		</footer>

		<script is:inline>
			var themeToggle = document.querySelector(".theme-toggle");
			var root = document.documentElement;

			function setCookie(name, value, maxAge) {
				var secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge || 31536000}; SameSite=Lax${secure}`;
				}
			}

			function getTheme() {
				var match = document.cookie.match(/(?:^|;\s*)theme=(light|dark)(?:;|$)/);
				if (match) return match[1];
				return window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light";
			}

			function setTheme(theme) {
				setCookie("theme", theme);
				root.classList.remove("light", "dark");
				root.classList.add(theme);
				root.style.colorScheme = theme;
				themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
			}

			setTheme(getTheme());
			themeToggle?.addEventListener("click", () =>
				setTheme(root.classList.contains("dark") ? "light" : "dark")
			);
		</script>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
