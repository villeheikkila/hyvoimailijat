---
import { decodeSlug } from "emdash";

const slug = decodeSlug(Astro.params.slug);

const redirects: Record<string, string> = {
	seura: "/seura",
	"liity-jaseneksi": "/liity-jaseneksi",
	"hyv-voimaliiga-saannot": "/hyv-voimaliiga-saannot",
	"tulokset-3": "/tulokset",
	uutiset: "/posts",
	ranking: "/ranking",
	about: "/en/about",
	"become-a-member": "/en/become-a-member",
	rules: "/en/rules",
	results: "/en/results",
	news: "/posts",
	"ranking-en": "/en/ranking",
};

const target = slug ? redirects[slug] : null;

if (!target) {
	return new Response(null, { status: 404 });
}

return Astro.redirect(target, 301);
---
