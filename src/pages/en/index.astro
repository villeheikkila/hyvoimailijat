---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import {
	attachVenues,
	formatEventDateTimeRange,
	getEventDate,
	getUpcomingEvents,
} from "../../utils/events";
import { getReadingTime } from "../../utils/reading-time";

const [
	{ entries: posts, cacheHint: postsCacheHint },
	{ entries: events, cacheHint: eventsCacheHint },
	{ entries: venues, cacheHint: venuesCacheHint },
] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 10,
	}),
	getEmDashCollection("events", {
		orderBy: { start_at: "asc" },
		limit: 100,
	}),
	getEmDashCollection("venues", {
		limit: 50,
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(postsCacheHint);
	Astro.cache.set(eventsCacheHint);
	Astro.cache.set(venuesCacheHint);
}

const heroPost = posts.find((post) => post.data.featured_image);
const latestPosts = posts.slice(0, 10);
const upcomingEvents = getUpcomingEvents(attachVenues(events, venues)).slice(0, 3);

function formatDate(date: Date | null | undefined) {
	if (!date) return null;
	return date.toLocaleDateString("en-GB", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<Base
	title="Helsingin Yliopiston Voimailijat"
	description="Student strength sports club in Helsinki."
	lang="en"
>
	<section class="club-hero">
		<div class="club-hero-copy">
			<p class="eyebrow">Helsingin Yliopiston Voimailijat</p>
			<h1>Student strength sports club in Helsinki.</h1>
			<p>
				HYV organizes approachable strength competitions, brings students
				together to train, and offers a route to official powerlifting meets.
			</p>
			<div class="hero-actions">
				<a href="/en/become-a-member" class="button primary">Become a member</a>
			</div>
		</div>
		{heroPost?.data.featured_image && (
			<a href={`/posts/${heroPost.id}`} class="hero-media">
				<Image image={heroPost.data.featured_image} />
				<span>{heroPost.data.title}</span>
			</a>
		)}
	</section>

	<section class="fact-row home-facts" aria-label="Club facts">
		<div class="fact-item">
			<span>Founded</span>
			<strong>17 March 2010</strong>
		</div>
		<div class="fact-item">
			<span>Membership</span>
			<strong>10 euros / year</strong>
		</div>
		<div class="fact-item">
			<span>First try</span>
			<strong>First competition is free</strong>
		</div>
		<div class="fact-item">
			<span>Federation</span>
			<strong>SVNL</strong>
		</div>
	</section>

	{upcomingEvents.length > 0 && (
		<section class="home-events">
			<header class="section-heading">
				<p class="eyebrow">Upcoming events</p>
				<h2>Calendar</h2>
				<a href="/en/events">All events</a>
			</header>
			<div class="home-events-list">
				{upcomingEvents.map((event) => (
					<a href={`/tapahtumat/${event.id}`} class="event-card">
						<time datetime={getEventDate(event.data.start_at)?.toISOString()}>
							{formatEventDateTimeRange(event, "en")}
						</time>
						<h3>{event.data.title}</h3>
						{event.venueEntry && <p>{event.venueEntry.data.title}</p>}
					</a>
				))}
			</div>
		</section>
	)}

	<section class="latest-section">
		<header class="section-heading">
			<p class="eyebrow">Current</p>
			<h2>News and results</h2>
			<a href="/posts">All articles</a>
		</header>
		<div class="news-list">
			{latestPosts.map((post) => (
				<a href={`/posts/${post.id}`} class="article-card">
					{post.data.featured_image && (
						<div class="article-card-image">
							<Image image={post.data.featured_image} />
						</div>
					)}
					<div class="article-card-body">
						<span class="article-card-meta">
							{formatDate(post.data.publishedAt)}
							{" / "}
							{getReadingTime(post.data.content)} min
						</span>
						<h3>{post.data.title}</h3>
						<p>{post.data.excerpt}</p>
					</div>
				</a>
			))}
		</div>
	</section>
</Base>
