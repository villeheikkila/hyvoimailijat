---
import { getEmDashCollection, getTerm, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveShell from "../../components/ArchiveShell.astro";
import FeedCard from "../../components/FeedCard.astro";
import FeedGrid from "../../components/FeedGrid.astro";
import { getPostFeedMeta } from "../../utils/feed";

const term = await getTerm("category", "results");

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"tag",
);
---

<Base title="Results" description="HYV competition results and reports" lang="en">
	<ArchiveShell
		label="Competitions"
		title="Results"
		count={`${posts.length} ${posts.length === 1 ? "report" : "reports"}`}
	>
		<FeedGrid>
			{posts.map((post) => (
				<FeedCard
					title={post.data.title}
					description={post.data.excerpt}
					image={post.data.featured_image}
					href={`/posts/${post.id}`}
					meta={getPostFeedMeta(post.data.publishedAt, post.data.content, "en")}
					tags={(tagsByEntry.get(post.data.id) ?? []).map((tag) => ({
						slug: tag.slug,
						label: tag.label,
					}))}
				/>
			))}
		</FeedGrid>
	</ArchiveShell>
</Base>
