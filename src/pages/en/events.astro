---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveShell from "../../components/ArchiveShell.astro";
import FeedCard from "../../components/FeedCard.astro";
import {
	attachVenues,
	formatEventDateTimeRange,
	getEventDate,
	getEventStatusLabel,
	getPastEvents,
	getUpcomingEvents,
	groupEventsByYear,
} from "../../utils/events";

const [
	{ entries: events, cacheHint: eventsCacheHint },
	{ entries: venues, cacheHint: venuesCacheHint },
] = await Promise.all([
	getEmDashCollection("events", {
		orderBy: { start_at: "desc" },
		limit: 500,
	}),
	getEmDashCollection("venues", {
		limit: 50,
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(eventsCacheHint);
	Astro.cache.set(venuesCacheHint);
}

const eventsWithVenues = attachVenues(events, venues);
const upcomingEvents = getUpcomingEvents(eventsWithVenues);
const pastEventsByYear = groupEventsByYear(getPastEvents(eventsWithVenues));
---

<Base title="Events" description="HYV competition calendar and event archive" lang="en">
	<ArchiveShell label="Competitions" title="Events" count={`${events.length} events`}>
		{upcomingEvents.length > 0 && (
			<section class="events-section">
				<h2>Upcoming Events</h2>
				<div class="events-list">
					{upcomingEvents.map((event) => (
						<FeedCard
							variant="row"
							href={`/tapahtumat/${event.id}`}
							title={event.data.title}
							description={`${event.venueEntry?.data.title ?? ""}${event.venueEntry?.data.city ? `, ${event.venueEntry.data.city}` : ""}`}
							meta={[{
								label: formatEventDateTimeRange(event, "en"),
								datetime: getEventDate(event.data.start_at)?.toISOString(),
							}]}
						/>
					))}
				</div>
			</section>
		)}

		<section class="events-section">
			<h2>Archive</h2>
			<div class="event-years">
				{pastEventsByYear.map(([year, yearEvents]) => (
					<section class="event-year">
						<h3>{year}</h3>
						<div class="events-list">
							{yearEvents.map((event) => (
								<FeedCard
									variant="row"
									href={`/tapahtumat/${event.id}`}
									title={event.data.title}
									description={`${event.venueEntry?.data.title ?? ""}${event.venueEntry?.data.city ? `, ${event.venueEntry.data.city}` : ""}${event.data.event_status === "cancelled" ? ` / ${getEventStatusLabel(event.data.event_status, "en")}` : ""}`}
									meta={[{
										label: formatEventDateTimeRange(event, "en"),
										datetime: getEventDate(event.data.start_at)?.toISOString(),
									}]}
								/>
							))}
						</div>
					</section>
				))}
			</div>
		</section>
	</ArchiveShell>
</Base>

<style>
	.events-section {
		display: grid;
		gap: var(--spacing-5);
		margin-top: var(--spacing-10);
	}

	.events-section > h2,
	.event-year > h3 {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
	}

	.event-years {
		display: grid;
		gap: var(--spacing-10);
	}

	.event-year {
		display: grid;
		gap: var(--spacing-4);
	}
</style>
