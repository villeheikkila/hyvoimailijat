---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";

const { entries: events, cacheHint } = await getEmDashCollection("tribe_events", {
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const formatDate = (date: Date | null | undefined) =>
	date
		? date.toLocaleDateString("fi-FI", {
				year: "numeric",
				month: "long",
				day: "numeric",
			})
		: null;
---

<Base title="Kisakalenteri" description="HYV:n kilpailukalenteri">
	<section class="events-page">
		<header class="events-header">
			<span class="events-label">Kilpailut</span>
			<h1>Kisakalenteri</h1>
			<p>HYV:n Voimaliigan kilpailut ja seuran tapahtumat.</p>
		</header>

		<div class="events-list">
			{events.map((event) => (
				<article class="event-item">
					{event.data.publishedAt && <time>{formatDate(event.data.publishedAt)}</time>}
					<h2>{event.data.title}</h2>
					{event.data.excerpt && <p>{event.data.excerpt}</p>}
				</article>
			))}
		</div>
	</section>
</Base>

<style>
	.events-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-16);
	}

	.events-header {
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-5);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.events-label {
		display: block;
		margin-bottom: var(--spacing-2);
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
	}

	.events-header h1 {
		margin-bottom: var(--spacing-3);
		font-size: var(--title-page-compact);
		font-weight: var(--font-weight-display);
	}

	.events-header p,
	.event-item p {
		color: var(--color-text-secondary);
	}

	.event-item {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.event-item time {
		display: block;
		margin-bottom: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.event-item h2 {
		margin-bottom: var(--spacing-2);
		font-size: var(--font-size-2xl);
	}
</style>
