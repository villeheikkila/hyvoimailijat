---
import { getEmDashCollection, getTerm, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import ArchiveShell from "../components/ArchiveShell.astro";
import FeedCard from "../components/FeedCard.astro";
import FeedGrid from "../components/FeedGrid.astro";
import { getPostFeedMeta } from "../utils/feed";

const term = await getTerm("category", "tulokset");

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"tag",
);
---

<Base title="Tulokset" description="HYV:n kilpailutulokset ja kisaraportit">
	<ArchiveShell label="Kilpailut" title="Tulokset" count={`${posts.length} kisaraporttia`}>
		<FeedGrid>
			{posts.map((post) => (
				<FeedCard
					title={post.data.title}
					description={post.data.excerpt}
					image={post.data.featured_image}
					href={`/posts/${post.id}`}
					meta={getPostFeedMeta(post.data.publishedAt, post.data.content, "fi")}
					tags={(tagsByEntry.get(post.data.id) ?? []).map((tag) => ({
						slug: tag.slug,
						label: tag.label,
					}))}
				/>
			))}
		</FeedGrid>
	</ArchiveShell>
</Base>
