---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import ArchiveShell from "../../components/ArchiveShell.astro";
import FeedCard from "../../components/FeedCard.astro";
import FeedGrid from "../../components/FeedGrid.astro";
import { getPostFeedMeta } from "../../utils/feed";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"tag",
);
---

<Base title="Uutiset" description="HYV:n uutiset, artikkelit ja kisaraportit">
	<ArchiveShell label="Ajankohtaista" title="Uutiset" count={`${posts.length} artikkelia`}>
		<FeedGrid>
			{posts.map((post) => (
				<FeedCard
					title={post.data.title}
					description={post.data.excerpt}
					image={post.data.featured_image}
					href={`/posts/${post.id}`}
					meta={getPostFeedMeta(post.data.publishedAt, post.data.content, "fi")}
					tags={(tagsByEntry.get(post.data.id) ?? []).map((tag) => ({
						slug: tag.slug,
						label: tag.label,
					}))}
				/>
			))}
		</FeedGrid>
	</ArchiveShell>
</Base>
