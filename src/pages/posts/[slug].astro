---
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import Base from "../../layouts/Base.astro";
import RichPortableText from "../../components/RichPortableText.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;

	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}

	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);

	return storageKey
		? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`
		: undefined;
}

const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage: featuredImageUrl,
});

const tags = post.data.terms?.tag ?? [];
const publishDate =
	post.data.publishedAt?.toLocaleDateString("fi-FI", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">
		<div class="article-main">
			<header class="article-header">
				<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
				{
					post.data.excerpt && (
						<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
					)
				}
			</header>

			<div class="article-content">
				<RichPortableText value={post.data.content} />
			</div>

			<footer class="article-footer">
				{
					tags.length > 0 && (
						<div class="article-tags" aria-label="Avainsanat">
							{tags.map((tag) => (
								<a href={`/tag/${tag.slug}`} class="article-tag">
									{tag.label}
								</a>
							))}
						</div>
					)
				}
				{
					publishDate && (
						<p class="article-published">
							Julkaistu <time datetime={post.data.publishedAt?.toISOString()}>{publishDate}</time>
						</p>
					)
				}
			</footer>
		</div>
	</article>
</Base>

<style>
	.article {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.article-main {
		max-width: calc(var(--content-width) + var(--spacing-12));
		margin: var(--spacing-12) auto var(--spacing-16);
		padding: 0 var(--layout-margin);
	}

	.article-header {
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-5);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.article-title {
		margin-bottom: var(--spacing-4);
		font-size: var(--title-article);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: 0;
	}

	.article-excerpt {
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
	}

	.article-content {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
	}

	.article-content :global(p) {
		margin-bottom: 1.5em;
	}

	.article-content :global(h2) {
		margin-top: 2.5em;
		margin-bottom: 0.75em;
		font-size: var(--font-size-2xl);
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.article-content :global(h3) {
		margin-top: 2em;
		margin-bottom: 0.5em;
		font-size: var(--font-size-xl);
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.article-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-border);
		border-radius: 0 var(--radius) var(--radius) 0;
		color: var(--color-text-secondary);
		background: var(--color-bg-subtle);
		font-style: italic;
	}

	.article-content :global(pre) {
		margin: 2em 0;
		padding: var(--spacing-5);
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.article-content :global(code) {
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	.article-content :global(pre code) {
		padding: 0;
		background: none;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.article-content :global(li) {
		margin-bottom: 0.5em;
	}

	.article-content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 2em auto;
		border-radius: var(--radius-lg);
	}

	.article-content :global(figure) {
		margin: 2em 0;
	}

	.article-content :global(figure img) {
		margin: 0 auto;
	}

	.article-content :global(figcaption) {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		text-align: center;
	}

	.article-content :global(hr) {
		margin: 3em 0;
		border: 0;
		border-top: 1px solid var(--color-border);
	}

	.article-content :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.article-content :global(a:hover) {
		text-decoration-thickness: 2px;
	}

	.article-footer {
		display: grid;
		gap: var(--spacing-4);
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.article-tag {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		padding: 0 var(--spacing-3);
		border-radius: var(--radius);
		color: var(--color-text-secondary);
		background: var(--color-bg-subtle);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.article-tag:hover {
		color: var(--color-text);
		background: var(--color-border-subtle);
	}

	.article-published {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	@media (max-width: 900px) {
		.article-main {
			margin-top: var(--spacing-8);
			padding: 0 var(--layout-margin);
		}
	}

	@media (max-width: 600px) {
		.article-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
