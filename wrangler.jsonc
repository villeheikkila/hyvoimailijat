{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hyvoimailijat",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hyvoimailijat-db","database_id": "d1621ae3-45ee-4807-9038-c0222a4c13e4",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "hyvoimailijat-media","preview_bucket_name": "hyvoimailijat-media",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
	"env": {
		"staging": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "hyvoimailijat-staging-db",
					"database_id": "9a4dd185-6968-4788-a81d-4831bbad467a",
					"remote": true,
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "hyvoimailijat-staging-media",
					"remote": true,
				},
			],
		},
	},
}
